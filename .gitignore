# dependencies / envs
node_modules/
.venv/
__pycache__/
*.pyc

# renders + caches (heavy, regenerate anytime)
output/
models/
assets/_cache/
assets/demo/
assets/manifest.json
remotion/public/job/
remotion/out/

# PRIVATE MEDIA: repo public hai, isliye raw media by default git me nahi jaata.
# (GitHub website se upload karna phir bhi kaam karta hai. Repo private karne ke baad
#  ye lines hata sakte ho.)
assets/raw-videos/*
!assets/raw-videos/.gitkeep
assets/photos/*
!assets/photos/.gitkeep
assets/scripts/*
!assets/scripts/.gitkeep

# secrets never in git
.env
*.key
.claude/settings.local.json

# Agent productions: private by default (scripts/briefs may be confidential).
# Only the README and synthetic test productions (_tests, deleg-test-*) are tracked, without heavy media.
productions/*
!productions/README.md
!productions/_tests/
!productions/deleg-test-1/
!productions/deleg-test-2/
productions/**/*.mp4
productions/**/*.wav
productions/**/*.mp3
productions/**/*.mkv
